{
  "name": "aurisar-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "npm run sync:terrain-assets",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "sync:content": "node scripts/sync_world_content.mjs",
    "sync:content:check": "node scripts/sync_world_content.mjs --check",
    "emit:castle": "node scripts/emit-castle-manifest.mjs",
    "emit:castle:check": "node scripts/emit-castle-manifest.mjs --check",
    "emit:world-chests": "node scripts/emit_world_chests.mjs",
    "emit:world-chests:check": "node scripts/emit_world_chests.mjs --check",
    "emit:landmarks": "node scripts/emit_zone1_landmarks.mjs",
    "emit:landmarks:check": "node scripts/emit_zone1_landmarks.mjs --check",
    "plan": "node scripts/render_world_plan.mjs",
    "plan:all": "node scripts/render_world_plan.mjs --view world && node scripts/render_world_plan.mjs --view zone && node scripts/render_world_plan.mjs --view hub",
    "assets:pipeline": "node scripts/assets_pipeline.mjs",
    "check:assets": "node scripts/assets_pipeline.mjs --check",
    "emit:assets": "node scripts/assets_pipeline.mjs --emit",
    "vendor:meshopt": "node scripts/vendor_meshopt_decoder.mjs",
    "vendor:meshopt:check": "node scripts/vendor_meshopt_decoder.mjs --check",
    "build:audio": "node scripts/build_audio_sfx.mjs",
    "check:audio": "node scripts/build_audio_sfx.mjs --check",
    "build:terrain-assets": "node scripts/build_terrain_assets.mjs",
    "check:terrain-assets": "node scripts/build_terrain_assets.mjs --check",
    "sync:terrain-assets": "node scripts/sync_terrain_assets.mjs",
    "sync:terrain-assets:check": "node scripts/sync_terrain_assets.mjs --check",
    "prepare:terrain-sources": "node scripts/prepare_terrain_sources.mjs",
    "check:terrain-sources": "node scripts/prepare_terrain_sources.mjs --check",
    "fetch:terrain-source": "node scripts/fetch_terrain_source_set.mjs",
    "check:terrain-source": "node scripts/fetch_terrain_source_set.mjs --check",
    "prebuild": "npm run sync:terrain-assets && npm run emit:castle && npm run emit:world-chests && npm run emit:landmarks && npm run sync:content",
    "build:glb": "node scripts/build_glb_assets.mjs",
    "build:sentinel": "node scripts/build_gilded_sentinel.mjs",
    "build:gameplay": "node scripts/copy_gameplay_to_public.mjs",
    "bake:tiles": "node scripts/bake_ashwood_tiles.mjs",
    "bake:heightmap": "node scripts/bake_ashwood_heightmap.mjs",
    "verify:worldgen": "node scripts/verify_worldgen.mjs",
    "emit:db-contract": "node scripts/check_db_contract.mjs",
    "emit:db-contract:check": "node scripts/check_db_contract.mjs --check",
    "lint:undef": "node scripts/check_no_undef.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "babylonjs": "9.19.0",
    "babylonjs-gui": "9.19.0",
    "babylonjs-loaders": "9.19.0",
    "babylonjs-serializers": "9.19.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-is": "^19.2.8",
    "react-window": "^2.3.0",
    "recharts": "^3.10.1",
    "spacetimedb": "^2.7.0",
    "svix": "^1.99.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "jsdom": "^29.1.1",
    "meshoptimizer": "^1.2.0",
    "sharp": "^0.35.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
