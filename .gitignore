# Locally-installed agent skill packs (dev-machine tooling, not app code).
.claude/skills/

# Raw terrain source scans are local/heavy inputs. Commit only text metadata and
# reproduce the sources through the locked acquisition scripts.
assets-source/terrain/**
!assets-source/terrain/README.md
!assets-source/terrain/.gitkeep

# public/assets/terrain/generated/** is COMMITTED (together with
# config/terrain-assets.lock.json) so Netlify/CI builds never fetch terrain
# sources from third-party hosts. Do not re-ignore it — see the regression
# guard in scripts/sync_terrain_assets.mjs.

# Generated world plan vectors (regenerate with `npm run plan`); PNGs are kept.
docs/world-plans/*.svg
