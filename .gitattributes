# World content + its generated server mirror are compared byte-for-byte
# by scripts/sync_world_content.mjs (--check). Pin them to LF so
# core.autocrlf=true Windows checkouts don't break the equality test.
src/features/world/content/** text eol=lf
spacetimedb/src/content/** text eol=lf

# The terrain offline gate hashes manifest.json byte-for-byte against
# config/terrain-assets.lock.json (scripts/terrain_sync_state.mjs). Pin both
# to LF so core.autocrlf=true Windows checkouts don't false-stale the gate.
public/assets/terrain/manifest.json text eol=lf
config/terrain-assets.lock.json text eol=lf
# The generated textures are hashed too; mark them binary explicitly so no
# client config (e.g. a global `* text=auto`) can ever rewrite their bytes.
public/assets/terrain/generated/** binary

# README screenshots — binary so no line-ending config touches them.
docs/readme/** binary
