# ── Client (VITE_*) — inlined into the public browser bundle ────────────────
# Supabase public client config. The anon key is safe to expose (RLS is the
# real boundary), but keeping it in env makes rotation easier. REQUIRED:
# src/utils/supabase.js throws at boot if either is missing or still set to
# the placeholder below, so a misconfigured build fails loudly instead of
# silently writing to the production project.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# 3D Realm (SpacetimeDB). Optional — defaults are in
# src/features/world/useSpacetimeWorld.js.
VITE_SPACETIMEDB_URI=wss://maincloud.spacetimedb.com
VITE_SPACETIMEDB_MODULE=aurisar-world

# Cloudflare Turnstile site key (bot check on the support form). Public.
VITE_TURNSTILE_SITE_KEY=

# Preview / dev access mode.
# In dev (`npm run dev`) preview mode is always enabled and uses
# VITE_PREVIEW_PIN if set, falling back to "1234".
# In a production build it is stripped from the bundle entirely
# unless you set VITE_ALLOW_PREVIEW=true at build time (e.g. for staging).
# NOTE: the client PIN is NOT a secret — anything used in browser code is
# inlined into the public JS bundle. Real access control for public preview
# deploys is enforced server-side by netlify/edge-functions/preview-auth.js
# (see the PREVIEW_BASIC_AUTH_* vars below).
VITE_ALLOW_PREVIEW=false
VITE_PREVIEW_PIN=1234

# ── Server-side gate for public preview/branch deploys ──────────────────────
# These are SERVER-SIDE Netlify env vars (NOT prefixed with VITE_), so they are
# never exposed to the browser bundle. netlify/edge-functions/preview-auth.js
# enforces HTTP Basic Auth with them on `deploy-preview` and `branch-deploy`
# contexts only (production and local dev are never gated). Set BOTH in Netlify
# → Site settings → Environment variables, scoped to Deploy Previews / Branch
# deploys. If unset on a gated deploy, the site returns 503 (fails closed).
# They are only needed for a local `netlify dev` run that simulates a gated
# context; plain `npm run dev` never gates.
PREVIEW_BASIC_AUTH_USER=previewer
PREVIEW_BASIC_AUTH_PASSWORD=choose-a-strong-password

# ── Server-side only (Netlify Functions) — NEVER prefixed with VITE_ ────────
# These must never reach the browser bundle.

# Supabase server credentials. SUPABASE_URL/ANON mirror the VITE_ pair above;
# the SERVICE_ROLE key bypasses RLS and is used by the admin endpoints, the
# notifications drain and the reminder producer.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend — transactional email (welcome, support, invites, notification drain).
RESEND_API_KEY=re_your_key
# Signing secret for the bounce/complaint webhook (Resend → Webhooks → whsec_…).
# Consumed by netlify/functions/resend-webhook.js to populate the suppression
# list; without it the webhook rejects every delivery event.
RESEND_WEBHOOK_SECRET=whsec_your_secret

# Cloudflare Turnstile secret (pairs with VITE_TURNSTILE_SITE_KEY).
TURNSTILE_SECRET_KEY=

# WHOOP integration (OAuth fitness-data import).
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=https://aurisargames.com/whoop/callback

# GitHub token used by netlify/functions/create-github-issue.js to file
# feedback submissions as issues.
GITHUB_TOKEN=
